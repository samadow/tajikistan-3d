# Copy to .env and change every value before deploying.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Set to 0 when serving plain http (local docker); keep 1 behind https.
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=tajikistan3d
POSTGRES_USER=tajikistan3d
POSTGRES_PASSWORD=change-me

# Optional: create an admin account on first start.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
DJANGO_SUPERUSER_EMAIL=admin@example.com

SEED_ON_START=1
WEB_PORT=8080

# Backups (docker compose service "backup"): days to keep dumps in ./backups
BACKUP_KEEP_DAYS=14

# HTTPS overlay (docker-compose.prod.yml): the public domain name
DOMAIN=example.com

# Real map (/map) — both optional, both free:
# Mapillary client token -> street-level photos and 360° panoramas
#   https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# ArcGIS Location Platform API key -> high-resolution satellite imagery (Esri World Imagery).
# Without it the satellite layer uses Sentinel-2 cloudless (EOX, ~10 m/px, CC BY-NC-SA 4.0).
#   https://location.arcgis.com/
ARCGIS_API_KEY=
